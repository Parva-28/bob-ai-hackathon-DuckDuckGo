# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

