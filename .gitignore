# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files (use demo-video-link.txt instead) ───────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
# NOT a bare `data/`: that matches every directory named data at any depth, which
# is what silently hid the trained models, the SECOM preprocessing artifacts and
# the MCP server's cases/lots/telemetry files. A fresh clone could not even
# import the server. Large inputs are excluded by path below instead.
/data/
logs/
*.log

# ── Jupyter Notebooks (optional: remove if you want to commit notebooks) ──────
# .ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup

# Track 3 — MCP server
.venv/
src/mcp_server/data/feedback.jsonl

# Track 1 — WM-811K. Exclude the bulk INPUTS, keep the trained model.
# LSWMD.pkl is 2.1 GB and X_train.npy 829 MB; data_prep.py regenerates both.
src/models/vision/data/*.pkl
src/models/vision/data/*.npy
# Superseded and rejected checkpoints — the shipped one is best_model.pt
src/models/vision/checkpoints/best_model_vit.pt
src/models/vision/checkpoints/best_model_v1_*.pt

# Track 2 — SECOM. X_train/y_train ARE tracked: lot_sensors.build_vector picks a
# class medoid from them and score_sensor_anomaly returns 0.00 without it.
src/models/tabular/data/secom*.data
src/models/tabular/data/X_val.npy
src/models/tabular/data/y_val.npy
# redundant with medians.pkl, which is what anomaly.py actually loads
src/models/tabular/data/medians.npy

# Track A — PHM 2016. Only cmp_train.csv is tracked. The competition's val and
# test splits ship with AVG_REMOVAL_RATE masked as "?", so they carry no labels
# and nothing at runtime reads them.
src/models/cmp/data/cmp_val.csv
src/models/cmp/data/cmp_test.csv

colab/wm811k_64.npz

# macOS / editor junk
__MACOSX/
.DS_Store
.agents/

# PHM 2016 CMP raw traces (~11 MB, 558 CSVs) — data_prep.py re-downloads them
src/models/cmp/data/raw/
src/mcp_server/data/prior_reads.jsonl

# ── why models are tracked ────────────────────────────────────────────────────
# Trained models and their preprocessing artifacts are COMMITTED, deliberately.
# They total ~12 MB and without them a fresh clone is not merely degraded, it is
# broken in three separate ways we found by actually cloning it:
#
#   1. the MCP server could not import at all — cases.json was ignored
#   2. the tabular checkpoint was committed but its scaler and medians were not,
#      so _load_artifacts() failed and every tool fell back to a stub
#   3. score_sensor_anomaly returned 0.00 for every lot without X_train.npy,
#      flipping case_6a to the wrong category
#
# Rules above exclude bulk INPUTS by path, never by directory name, so a
# retrained checkpoint is picked up automatically instead of needing `git add -f`.
# Regenerate the excluded inputs with:
#
#   python3 src/models/vision/data_prep.py     # needs LSWMD.pkl from Kaggle
#   python3 src/models/tabular/data_prep.py
#   python3 src/models/cmp/data_prep.py
