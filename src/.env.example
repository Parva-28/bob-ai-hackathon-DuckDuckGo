# Copy this file to src/.env and fill in your actual values.
# src/.env is gitignored — NEVER commit it, and never put any of these values in
# .bob/mcp.json, which IS committed so judges can see the Bob wiring.

# ─── Reasoning provider ───────────────────────────────────────────────────────
# "gemini" (default) or "watsonx". pipeline_status reports which is live.
REASONING_PROVIDER=gemini

# ─── Google Gemini (default provider) ────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_api_key_here
# Free-tier request limits differ sharply by model and the eval harness paces
# itself to them (--rpm): flash-lite allows 15/min, flash only 5/min. An unpaced
# run against flash 429s and reports 0/18 as if the reasoning layer were broken.
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# ─── watsonx.ai (alternative provider) ────────────────────────────────────────
# Required only when USE_MOCK_LLM=false.
# All three must be set together, and WATSONX_URL must match your project's
# region — a mismatch fails as a confusing 404 rather than an auth error.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Regions: us-south | eu-de | eu-gb | jp-tok | au-syd
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Set false to call the provider for real. Keep TRUE for development and CI:
# an 18-fixture eval run makes ~36 reasoning calls. On watsonx the Lite tier
# allows 300,000 tokens/month; on Gemini the free tier is rate-limited per
# minute. Spend live calls on the demo and one verification pass.
USE_MOCK_LLM=true

# ─── IBM Bob (optional — only for the scripted `bob run` eval harness) ────────
# `bob run` normally uses your local Bob installation's existing sign-in, so
# this is usually NOT needed. Try `bob run "hello"` first before setting it.
BOB_API_KEY=

# ─── YieldGuard MCP server ────────────────────────────────────────────────────
# Optional. Where engineer verdicts are appended (FR-10 feedback write-back).
# Defaults to src/mcp_server/data/feedback.jsonl, which is gitignored.
YIELDGUARD_FEEDBACK_PATH=
